# Application
APP_ENV=development
LOG_LEVEL=INFO
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh

# Pancake API
PANCAKE_API_KEY=

# Meta Marketing API
META_ACCESS_TOKEN=
META_BUSINESS_ID=
META_API_VERSION=v23.0

# Private storage outside this repository
PRIVATE_DATA_ROOT=
PRIVATE_OUTPUT_ROOT=
PRIVATE_WORK_ROOT=

# SQL Server
SQL_SERVER=
SQL_DATABASE=ecommerce_analytics
SQL_DRIVER="ODBC Driver 18 for SQL Server"
SQL_AUTH_MODE=windows
SQL_USERNAME=
SQL_PASSWORD=
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=yes